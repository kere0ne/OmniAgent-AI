# Copy to .env and fill in. NEVER commit real values.
OMNI_SECRET_KEY=change-me-to-a-long-random-string
OMNI_DATABASE_URL=            # optional; default is a local SQLite file. e.g. postgresql://user:pass@host/omniagent
OMNI_DATA_DIR=                # optional; default ~/.omniagent/data
OMNI_UPLOAD_MAX_MB=200
OMNI_WORKSPACE_QUOTA_MB=500
OMNI_EXEC_TIMEOUT=60
OMNI_EXEC_TIMEOUT_MAX=600
OMNI_EXEC_CPU_SECONDS=120
OMNI_EXEC_MEM_MB=768
OMNI_RATE_LIMIT_PER_MIN=240
OMNI_TOKEN_TTL_HOURS=72
